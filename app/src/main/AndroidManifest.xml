<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Crashlytics y comprobación de cuentos nuevos en GitHub Pages -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- App para niños (política de Familias): sin identificador de publicidad -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Necesario en Android 11+ para comprobar si hay motor de texto a voz -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".CuentoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CuentameUnCuento"
        tools:targetApi="33">

        <!-- Una sola Activity con Compose. Funciona en vertical y en horizontal: el giro
             no la reinicia (Compose recoloca la pantalla y la narración sigue sonando). -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.CuentameUnCuento.Splash" />

        <!-- El icono del launcher apuntaba a SplashActivity: el alias conserva ese nombre
             para que los accesos directos que ya tenga la gente sigan funcionando -->
        <activity-alias
            android:name=".SplashActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
