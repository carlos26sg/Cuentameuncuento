<resources>
    <!-- Tema base. Pantalla completa y edge-to-edge se configuran en código (PantallaCompleta.kt) -->
    <style name="Theme.CuentameUnCuento" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/green_500</item>
        <item name="colorPrimaryDark">@color/green_700</item>
        <item name="colorAccent">@color/teal_500</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:fontFamily">@font/anna</item>
        <item name="fontFamily">@font/anna</item>
    </style>

    <!-- Splash de Android 12+ (y compatible con versiones anteriores gracias a core-splashscreen) -->
    <style name="Theme.CuentameUnCuento.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CuentameUnCuento</item>
    </style>
</resources>
