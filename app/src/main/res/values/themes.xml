<resources>
    <!-- Tema de la ventana. Colores y letras de la interfaz están en ui/tema/Tema.kt (Compose) -->
    <style name="Theme.CuentameUnCuento" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/papel</item>
    </style>

    <!-- Splash de Android 12+ (y compatible con versiones anteriores gracias a core-splashscreen) -->
    <style name="Theme.CuentameUnCuento.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CuentameUnCuento</item>
    </style>
</resources>
