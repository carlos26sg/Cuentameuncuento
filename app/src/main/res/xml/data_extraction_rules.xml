<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y transferencia entre dispositivos en Android 12+.
     Ver backup_rules.xml para el motivo de la exclusión. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_user_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_user_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
