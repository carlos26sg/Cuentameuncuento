<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad en Android 11 y anteriores.
     Se excluyen las EncryptedSharedPreferences de la versión 2.0: su clave está en el
     Keystore del dispositivo y al restaurarlas en otro móvil la app se cerraba al arrancar. -->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_user_prefs.xml" />
</full-backup-content>
