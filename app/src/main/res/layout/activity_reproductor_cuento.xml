<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.reproductor.ReproductorCuento">

    <!-- Ilustración del cuento a pantalla completa -->
    <ImageView
        android:id="@+id/img_fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_principal" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margen_pantalla">

        <ImageButton
            android:id="@+id/btn_salir"
            style="@style/BotonIcono"
            android:contentDescription="@string/salir"
            android:src="@drawable/equis"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_musica"
            style="@style/BotonIcono"
            android:layout_width="@dimen/icono_musica_ancho"
            android:layout_height="@dimen/icono_musica_alto"
            android:layout_marginStart="@dimen/margen_pantalla"
            android:contentDescription="@string/silenciar_musica"
            android:src="@drawable/audio"
            app:layout_constraintBottom_toBottomOf="@id/btn_salir"
            app:layout_constraintStart_toEndOf="@id/btn_salir"
            app:layout_constraintTop_toTopOf="@id/btn_salir" />

        <Spinner
            android:id="@+id/sp_traduccion"
            style="@style/SpinnerBanderas"
            android:contentDescription="@string/traduccion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Error al cargar -->
        <LinearLayout
            android:id="@+id/grupo_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/fondo_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/error_cargar_cuento"
                android:textColor="@color/white"
                android:textSize="@dimen/texto_normal" />

            <Button
                android:id="@+id/btn_reintentar"
                style="@style/BotonPergamino"
                android:layout_marginTop="@dimen/margen_pantalla"
                android:text="@string/reintentar" />
        </LinearLayout>

        <!-- Texto del cuento y controles, en la parte inferior -->
        <LinearLayout
            android:id="@+id/grupo_cuento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txt_traducido"
                style="@style/TextoCuento"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_traduccion"
                android:layout_marginStart="@dimen/icono_pequeno"
                android:layout_marginEnd="@dimen/icono_pequeno"
                android:maxLines="2"
                android:textColor="@color/texto_traduccion"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_anterior"
                    style="@style/BotonIcono"
                    android:contentDescription="@string/anterior"
                    android:src="@drawable/back" />

                <ImageButton
                    android:id="@+id/btn_play_pausa"
                    style="@style/BotonIcono"
                    android:contentDescription="@string/escuchar"
                    android:src="@drawable/play" />

                <TextView
                    android:id="@+id/txt_cuento"
                    style="@style/TextoCuento"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_texto_cuento"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:layout_weight="1"
                    android:maxLines="3" />

                <ImageView
                    android:id="@+id/img_bandera"
                    android:layout_width="@dimen/bandera_ancho"
                    android:layout_height="@dimen/bandera_alto"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/btn_siguiente"
                    style="@style/BotonIcono"
                    android:contentDescription="@string/siguiente"
                    android:src="@drawable/next" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
