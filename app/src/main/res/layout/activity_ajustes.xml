<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ajustes.AjustesActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_menu" />

    <!-- ScrollView: en un móvil en horizontal no cabe todo -->
    <ScrollView
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/margen_pantalla">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_atras"
                    style="@style/BotonIcono"
                    android:contentDescription="@string/atras"
                    android:src="@drawable/atras" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_weight="1"
                    android:text="@string/ajustes"
                    android:textColor="@color/black"
                    android:textSize="@dimen/texto_titulo"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Panel de preferencias -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_pantalla"
                android:background="@color/fondo_panel"
                android:orientation="vertical"
                android:padding="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/EtiquetaAjustes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/sp_idioma"
                        android:text="@string/idioma_cuentos" />

                    <Spinner
                        android:id="@+id/sp_idioma"
                        style="@style/SpinnerBanderas" />
                </LinearLayout>

                <TextView
                    style="@style/EtiquetaAjustes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margen_pantalla"
                    android:gravity="center_horizontal"
                    android:text="@string/favoritos" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/EtiquetaAjustes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/sp_favorito"
                        android:text="@string/cuento_fav" />

                    <Spinner
                        android:id="@+id/sp_favorito"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:popupBackground="@color/fondo_panel" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/EtiquetaAjustes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/sp_modo"
                        android:text="@string/modo" />

                    <Spinner
                        android:id="@+id/sp_modo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:popupBackground="@color/fondo_panel" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botones: se reparten el ancho para caber en cualquier pantalla -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margen_pantalla"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_privacidad"
                    style="@style/BotonPergamino"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:layout_weight="1"
                    android:text="@string/privacidad" />

                <Button
                    android:id="@+id/btn_guardar"
                    style="@style/BotonPergamino"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/guardar" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
